# --- Hedera testnet ---
# Get a funded testnet account at https://portal.hedera.com/
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

# Topic the agent will use for provenance / fortune logs.
# Run `pnpm setup:topic` to create one and it will be appended here.
HEDERA_FORTUNE_TOPIC_ID=

# --- AI ---
# Either subscription (uses local `claude` CLI) or api (uses ANTHROPIC_API_KEY).
# For local demos, subscription avoids putting API secrets in this file.
AI_BACKEND=subscription
ANTHROPIC_API_KEY=

# --- Agent identity (ed25519) ---
# Optional — leave blank to auto-generate per run.
AGENT_IDENTITY_KEY=

# --- Tip economics ---
# Tinybars charged per fortune. 1 HBAR = 100_000_000 tinybars.
# Default: 10_000_000 tinybars = 0.1 HBAR.
FORTUNA_TIP_TINYBARS=10000000

# Account that receives the tips. Defaults to operator if blank.
FORTUNA_TIP_RECEIVER=
